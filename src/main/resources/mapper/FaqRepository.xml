<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kwang.climbstyle.domain.faq.repository.FaqRepository">
    <select id="selectAdminFaqListCountByRequest" parameterType="com.kwang.climbstyle.common.protocal.PaginationRequest"
            resultType="Integer">
        SELECT
            COUNT(faq_no)
        FROM
            tb_faq
        <where>
            <if test="searchName != null and searchName.trim() != ''">
                AND faq_question LIKE CONCAT('%', #{searchName}, '%')
            </if>
        </where>
    </select>

    <select id="selectAdminFaqList" parameterType="com.kwang.climbstyle.common.protocal.PaginationRequest"
            resultType="com.kwang.climbstyle.domain.admin.dto.response.AdminFaqListResponse">
        SELECT
            faq_no,
            faq_question,
            faq_visible_yn,
            faq_created
        FROM
            tb_faq
        <where>
            <if test="searchName != null and searchName.trim() != ''">
                AND faq_question LIKE CONCAT('%', #{searchName}, '%')
            </if>
        </where>
        ORDER BY
            faq_created DESC
        LIMIT #{pageSize} OFFSET #{startRowNum}
    </select>
</mapper>