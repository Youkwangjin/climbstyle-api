<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kwang.climbstyle.domain.ranking.repository.RankingRepository">
    <resultMap id="rankingResultMap"            type="com.kwang.climbstyle.domain.ranking.entity.RankingEntity">
        <id property="rankingNo"                column="ranking_no"/>
        <result property="feedNo"               column="feed_no"/>
        <result property="rankingType"          column="ranking_type"/>
        <result property="rankingOrder"         column="ranking_order"/>
        <result property="rankingLikeCount"     column="ranking_like_count"/>
        <result property="rankingPreviousOrder" column="ranking_previous_order"/>
        <result property="rankingUpdated"       column="ranking_updated"/>
        <association property="feed"            javaType="com.kwang.climbstyle.domain.feed.entity.FeedEntity"
                     resultMap="com.kwang.climbstyle.domain.feed.repository.FeedRepository.feedResultMap"/>
    </resultMap>

    <select id="selectRankingList" parameterType="string"
            resultType="com.kwang.climbstyle.domain.ranking.dto.response.RankingListResponse">
        SELECT
            r.ranking_no,
            r.ranking_order,
            r.ranking_like_count,
            r.ranking_previous_order,
            r.ranking_updated,
            f.feed_no,
            f.feed_title,
            f.user_no,
            u.user_nickname,
            u.user_image_url,
            ff.feed_file_no,
            ff.feed_file_path
        FROM
            tb_ranking r
        INNER JOIN
            tb_feed f
            ON r.feed_no = f.feed_no
        INNER JOIN
            tb_user u
            ON f.user_no = u.user_no
        LEFT JOIN
            tb_feed_file ff
            ON f.feed_no = ff.feed_no
        AND
            ff.feed_file_sort_order = 1
        WHERE
            r.ranking_type = #{rankingType}
        AND
            f.feed_visible_yn = 'Y'
        AND
            f.feed_like_visible_yn = 'Y'
        AND
            u.user_delete_yn = 'N'
        ORDER BY r.ranking_order ASC
    </select>
</mapper>