<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kwang.climbstyle.domain.menu.repository.MenuRepository">
    <resultMap id="menuResultMap"               type="com.kwang.climbstyle.domain.menu.entity.MenuEntity">
        <id property="menuNo"                   column="menu_no"/>
        <result property="menuCode"             column="menu_code"/>
        <result property="menuName"             column="menu_name"/>
        <result property="menuUrl"              column="menu_url"/>
        <result property="menuParentNo"         column="menu_parent_no"/>
        <result property="menuLevel"            column="menu_level"/>
        <result property="menuSortOrder"        column="menu_sort_order"/>
        <result property="menuUseYn"            column="menu_use_yn"/>
        <result property="menuIcon"             column="menu_icon"/>
        <result property="menuCreated"          column="menu_created"/>
        <result property="menuUpdated"          column="menu_updated"/>
    </resultMap>

    <select id="selectMenuByUserNo"
            resultType="com.kwang.climbstyle.domain.menu.dto.response.UserMenuListResponse">
        SELECT DISTINCT
            m.menu_name,
            m.menu_url,
            m.menu_level,
            m.menu_sort_order,
            m.menu_icon
        FROM
            tb_menu m
        INNER JOIN
            tb_role_menu rm
            ON rm.menu_no = m.menu_no
        INNER JOIN
            tb_user_role ur
            ON ur.role_no = rm.role_no
        WHERE
            ur.user_no = #{userNo}
        AND
            m.menu_use_yn = 'Y'
        ORDER BY
            m.menu_level,
            m.menu_sort_order
    </select>

    <select id="selectMenuByAdminNo" parameterType="Integer"
            resultType="com.kwang.climbstyle.domain.menu.dto.response.AdminMenuListResponse">
        SELECT DISTINCT
            m.menu_no,
            m.menu_code,
            m.menu_name,
            m.menu_url,
            m.menu_parent_no,
            m.menu_level,
            m.menu_sort_order,
            m.menu_icon
        FROM
            tb_menu m
        INNER JOIN
            tb_role_menu rm
            ON rm.menu_no = m.menu_no
        INNER JOIN
            tb_admin_role ar
            ON ar.role_no = rm.role_no
        WHERE
            ar.admin_no = #{adminNo}
        AND
            m.menu_use_yn = 'Y'
        ORDER BY
            m.menu_level,
            m.menu_sort_order
    </select>

    <select id="selectAllMenus"
            resultType="com.kwang.climbstyle.domain.menu.dto.response.AdminMenuManagementResponse">
        SELECT
            menu_no,
            menu_code,
            menu_name,
            menu_url,
            menu_parent_no,
            menu_level,
            menu_sort_order,
            menu_use_yn,
            menu_icon,
            menu_created
        FROM
            tb_menu
        ORDER BY
            menu_level,
            menu_sort_order
    </select>

    <select id="selectParentMenus"
            resultType="com.kwang.climbstyle.domain.menu.dto.response.AdminMenuManagementResponse">
        SELECT
            menu_no,
            menu_code,
            menu_name,
            menu_url,
            menu_parent_no,
            menu_level,
            menu_sort_order,
            menu_use_yn,
            menu_icon,
            menu_created
        FROM
            tb_menu
        WHERE
            menu_level = 1
        ORDER BY
            menu_sort_order
    </select>
</mapper>