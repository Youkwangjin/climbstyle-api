<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kwang.climbstyle.domain.feed.repository.FeedLikeRepository">
    <resultMap id="feedLikeResultMap"           type="com.kwang.climbstyle.domain.feed.entity.FeedLikeEntity">
        <id property="feedLikeNo"               column="feed_like_no"/>
        <result property="feedNo"               column="feed_no"/>
        <result property="userNo"               column="user_no"/>
        <result property="feedLikeCreated"      column="feed_like_created"/>
        <result property="feedLikeUpdated"      column="feed_like_updated"/>
    </resultMap>

    <select id="existFeedLikeByFeedNoAndUserNo" parameterType="Integer" resultType="Boolean">
        SELECT EXISTS(
            SELECT 1
            FROM
                tb_feed_like
            WHERE
                feed_no = #{feedNo}
              AND
                user_no = #{userNo}
        )
    </select>

    <select id="selectFeedLikeCountByFeedNo" parameterType="Integer" resultType="Integer">
        SELECT
            COUNT(feed_like_no)
        FROM
            tb_feed_like
        WHERE
            feed_no = #{feedNo}
    </select>

    <select id="selectFeedLikeListByNo" parameterType="Integer"
            resultType="com.kwang.climbstyle.domain.feed.dto.response.FeedLikeDetailResponse">
        SELECT
            fl.feed_like_no,
            u.user_nickname,
            u.user_image_url
        FROM
            tb_feed_like fl
        INNER JOIN
            tb_user u
            ON fl.user_no = u.user_no
        WHERE
            fl.feed_no = #{feedNo}
        ORDER BY
            fl.feed_like_created DESC
    </select>


    <insert id="insert" parameterType="com.kwang.climbstyle.domain.feed.entity.FeedLikeEntity"
            useGeneratedKeys="true" keyProperty="feedLikeNo">
        INSERT INTO tb_feed_like (
            feed_no,
            user_no,
            feed_like_created
        ) VALUES (
            #{feedNo},
            #{userNo},
            #{feedLikeCreated}
        )
        ON CONFLICT (feed_no, user_no) DO NOTHING
    </insert>

    <delete id="delete" parameterType="Integer">
        DELETE
        FROM
            tb_feed_like
        WHERE
            feed_no = #{feedNo}
        AND
            user_no = #{userNo}
    </delete>
</mapper>